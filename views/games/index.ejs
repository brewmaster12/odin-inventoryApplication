<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <ul>
        <% games.forEach((game) => { %>
            <li>
                <%= game.title %> (<%= game.release_year %>) - <%= game.developer %>
            </li>
        <% }) %>
    </ul>
</body>
</html>