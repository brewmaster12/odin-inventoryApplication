<!-- views/games/form.ejs -->
<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <% if (errors.length > 0) { %>
        <ul class="errors">
            <% errors.forEach((error) => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form method="POST">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= game.title || '' %>" required>

        <label for="release_year">Release year</label>
        <input type="number" id="release_year" name="release_year"
               min="1950" max="2100" value="<%= game.release_year || '' %>">

        <label for="developer_id">Developer</label>
        <select id="developer_id" name="developer_id" required>
            <option value="">Choose a developer</option>
            <% developers.forEach((d) => { %>
                <option value="<%= d.id %>" <%= d.id === game.developer_id ? "selected" : "" %>>
                    <%= d.name %>
                </option>
            <% }) %>
        </select>

        <fieldset>
            <legend>Genres</legend>
            <% genres.forEach((g) => { %>
                <label>
                    <input type="checkbox" name="genre_ids" value="<%= g.id %>"
                        <%= selectedGenreIds.includes(g.id) ? "checked" : "" %>>
                    <%= g.name %>
                </label>
            <% }) %>
        </fieldset>

        <button type="submit">Save</button>
    </form>
</body>
</html>