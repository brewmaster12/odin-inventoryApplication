<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= game.title %></h1>
    <p>Relased: <%= game.release_year %></p>
    <p>Developer: <%= game.developer %></p>
    

    <form method="POST" action="/games/<%= game.id %>/delete"
        onsubmit="return confirm('Delete this game?');">
        <button type="submit">Delete</button>
    </form>

</body>
</html>