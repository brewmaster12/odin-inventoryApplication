<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <ul>
        <% genres.forEach((genre) => { %>
            <li>
                <a href="/genres/<%= genre.id %>"><%= genre.name %></a>
            </li>
        <% }) %>
    </ul>
</body>
</html>