<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= dev.name %></h1>
    <ul>
        <% games.forEach((game) => { %>
            <li>
                <a href="/games/<%= game.id %>"><%= game.title %></a> (<%= game.release_year %>)
            </li>
        <% }) %>
    </ul>

    <form method="POST" action="/developers/<%= dev.id %>/delete"
        onsubmit="return confirm('Delete this developers? Its games will not be deleted.');">
        <button type="submit">Delete</button>
    </form>
    
</body>
</html>