<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <% if (errors.length > 0) { %>
        <ul class="errors">
            <% errors.forEach((error) => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>
    <form method="POST">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" value="<%= dev.name || '' %>" required>
        <button type="submit">Save</button>
    </form>
</body>
</html>